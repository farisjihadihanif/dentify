# AI Service (FastAPI + TensorFlow/Keras + LangChain/Gemini) - copy to .env
# Never commit .env to version control.

APP_ENV=development
PORT=8000
LOG_LEVEL=INFO

# Shared key required in X-Internal-Key header — MUST match AI_SERVICE_API_KEY in backend/.env
AI_SERVICE_API_KEY=dev-internal-key

# Gemini API (used strictly for Deni conversational agent, never for image classification)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Custom Keras Computer Vision model
MODEL_PATH=models/dentify_model.keras

# Screening thresholds and timeouts
MIN_CONFIDENCE=0.60
EMERGENCY_CONFIDENCE=0.85
LLM_TIMEOUT_S=20
