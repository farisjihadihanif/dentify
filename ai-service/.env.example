# ai-service (FastAPI + LiteRT/TFLite + LangChain/Gemini). Copy to .env and fill in locally.
# Names only: never commit values. On Render, set them in the dashboard (render.yaml lists them).
# Blank values fall back to the defaults in app/core/config.py.

# --- Required in production --------------------------------------------------------------
# "production" on Render; enables the startup check on AI_SERVICE_API_KEY
APP_ENV=
# Shared secret sent by the backend in X-Internal-Key; must equal the backend's AI_SERVICE_API_KEY
# (random, >= 24 characters in production)
AI_SERVICE_API_KEY=
# Build-time download URL for the model file (not in git), e.g. a GitHub Release asset
MODEL_URL=

# --- Optional -----------------------------------------------------------------------------
# Deni and the "is this a dental photo?" gate; without it Deni falls back to a static reply
GEMINI_API_KEY=
GEMINI_MODEL=
# SHA-256 of the file at MODEL_URL; the build fails on mismatch when set
MODEL_SHA256=
# "tflite" (default, no TensorFlow) or "keras" (needs requirements-train.txt and > 1 GB RAM)
MODEL_RUNTIME=
TFLITE_MODEL_PATH=
TFLITE_NUM_THREADS=
MODEL_PATH=
MODEL_META_PATH=
CONFIDENCE_THRESHOLD=
EMERGENCY_CONFIDENCE=
LLM_TIMEOUT_S=
LOG_LEVEL=
# Set by Render automatically; local default 8000
PORT=
