# Backend API Gateway (Express + TypeScript) - copy to .env
# Never commit .env to version control.

NODE_ENV=development
PORT=5000
TRUST_PROXY=0

# MongoDB Atlas (SRV default)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/denthub?retryWrites=true&w=majority
# Non-SRV replica-set fallback (use if local ISP/DNS blocks _mongodb._tcp SRV lookups):
# MONGODB_URI=mongodb://<user>:<password>@<shard-00-00>.mongodb.net:27017,<shard-00-01>.mongodb.net:27017,<shard-00-02>.mongodb.net:27017/denthub?tls=true&authSource=admin&retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=replace-with-a-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# CORS allowed origins (comma-separated, never hardcode production URLs in code)
CORS_ORIGINS=http://localhost:3000

# Internal AI Service (FastAPI) — MUST match AI_SERVICE_API_KEY in ai-service/.env
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=dev-internal-key

# OpenStreetMap (Overpass & Nominatim)
OVERPASS_URL=https://overpass-api.de/api/interpreter
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
OSM_USER_AGENT=DentHub/1.0 (capstone-cc26-psu285@denthub.local)

# Initial seeded Admin account (DATABASE.md §7)
ADMIN_NAME=Administrator DentHub
ADMIN_EMAIL=admin@denthub.local
ADMIN_PASSWORD=replace-with-strong-admin-password
