# Backend API (Express + MongoDB). Copy to .env and fill in locally.
# Names only: never commit values. On Vercel, set them in Project Settings.
# Blank values fall back to the local-development defaults in src/config/env.ts; with
# NODE_ENV=production the server refuses to start unless the required ones are set.

# --- Required in production --------------------------------------------------------------
# "production" on Vercel
NODE_ENV=
# MongoDB Atlas connection string for the app's own database user
MONGODB_URI=
# Random secret, >= 32 characters
JWT_SECRET=
# Comma-separated allowed frontend origins; `*` matches one label (Vercel previews)
CORS_ORIGINS=
# Public base URL of the ai-service, without a trailing slash
AI_SERVICE_URL=
# Same value as the ai-service's AI_SERVICE_API_KEY
AI_SERVICE_API_KEY=
# Seeded admin account (run `npm run seed` once); the password is never stored in plain text
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Optional -----------------------------------------------------------------------------
ADMIN_NAME=
# Number of proxy hops in front of the app for correct client IPs in rate limits (default 1 on Vercel)
TRUST_PROXY=
JWT_EXPIRES_IN=
BCRYPT_SALT_ROUNDS=
# How long to wait for the ai-service (default 90000); must cover a Render cold start and stay below
# maxDuration in vercel.json
AI_SERVICE_TIMEOUT_MS=
OVERPASS_URL=
NOMINATIM_URL=
# Identifying User-Agent for OpenStreetMap requests (their usage policy requires one)
OSM_USER_AGENT=
# Not used on Vercel; local default 5000
PORT=
