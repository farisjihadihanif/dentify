{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --include=dev --no-fund --no-audit",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "regions": ["sin1"],
  "functions": {
    "api/index.js": {
      "maxDuration": 120,
      "includeFiles": "dist/**"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }]
}
