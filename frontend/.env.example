# Frontend (Next.js). Copy to .env.local and fill in locally; on Vercel set them in
# Project Settings -> Environment Variables. Names only: never commit values.
# Only NEXT_PUBLIC_* variables reach the browser bundle. Never put GEMINI_API_KEY, MONGODB_URI,
# JWT_SECRET or AI_SERVICE_API_KEY here.

# --- Required on Vercel (the build fails without it) --------------------------------------
# Backend base URL including /api/v1, https only; local default http://localhost:5000/api/v1
NEXT_PUBLIC_API_URL=

# --- Optional -----------------------------------------------------------------------------
# Request timeout in ms (default 30000)
NEXT_PUBLIC_API_TIMEOUT_MS=
